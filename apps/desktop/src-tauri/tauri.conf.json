{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokalomat AI Studio",
  "version": "0.2.2",
  "identifier": "pl.lokalsi.studio",
  "build": {
    "beforeDevCommand": "npm run dev -w @lokalsi/ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @lokalsi/ui",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lokalomat AI Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AI Transformation Łukasz Poźniak",
    "copyright": "© 2026 Łukasz Poźniak. MIT License.",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://aitransformation.pl",
    "windows": {
      "wix": {
        "language": "pl-PL"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgomp1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQ0E5RTI5QkEwRDU4RDAKUldUUVdBMjZLWjdLM2JBOUlId251V3lXQmpxTldPd2tHUFBvRWFUQ1RUZGFUbHFVaGJzdSs3czcK",
      "endpoints": [
        "https://github.com/roxlukas/lokalomat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
