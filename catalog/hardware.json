{
  "version": 1,
  "description": "GPU catalogue for speed estimates (docs/adr/0016-speed-tiers.md). Matched by PCI vendor:device ID, then by lower-case name substring, first match wins. Unknown values stay null; never guess numbers.",
  "sources": [
    "Vendor specification pages: NVIDIA GeForce, AMD Radeon, Intel Arc/Iris/UHD, Apple tech specs",
    "PCI IDs: read from the OS (NVML, /sys/class/drm, Windows PnP) on the machines named in ADR 0016"
  ],
  "fields": {
    "compute_units": "NVIDIA SMs, AMD CUs, Intel EUs (Xe-cores on Arc), Apple GPU cores (base configuration)",
    "shader_cores": "ALUs: CUDA cores, stream processors, EU x 8, Apple cores x 128",
    "boost_mhz": "reference boost clock",
    "bandwidth_gbs": "peak memory bandwidth; null for integrated graphics (they share system RAM)",
    "relative speed": "not stored: FP32 TFLOPS = shader_cores x boost_mhz x 2 / 1e6 is derived in code",
    "bandwidth_by_max_units": "smaller configurations of the same chip: up to N units -> bandwidth (Apple Max)"
  },
